{
  "AWSTemplateFormatVersion": "2010-09-09",
  "Description": "sync.thingelstad.xyz: the publishing bus, the scheduled and event-driven sync page, and signed webhook intake",
  "Parameters": {
    "CodeKey": {
      "Type": "String",
      "Default": "",
      "Description": "S3 key of the packaged probe in the code bucket; empty on the first apply, which creates the buckets and roles only"
    },
    "CodeVersion": {
      "Type": "String",
      "Default": "",
      "Description": "Optional S3 object version of the packaged probe"
    },
    "CertificateArn": {
      "Type": "String",
      "Default": "",
      "Description": "ACM certificate for sync.thingelstad.xyz in us-east-1; empty serves the CloudFront domain only"
    },
    "PublisherUser": {
      "Type": "String",
      "Default": "wt-archive",
      "Description": "IAM user WT Builder signs its AWS calls with; it may put events on the publishing bus. Empty grants nobody."
    },
    "RuntimeSecret": {
      "Type": "String",
      "Default": "",
      "Description": "Name of sync-runtime. Reader keys: pinboard_token, microblog_api_key. Webhook signing keys buttondown_webhook_signing_key and github_webhook_signing_key resolve only when their sender flag is true."
    },
    "EnableButtondown": {
      "Type": "String",
      "Default": "false",
      "AllowedValues": [
        "false",
        "true"
      ],
      "Description": "Enable the signed Buttondown subscriber webhook only after its sync-runtime signing key exists and the provider is configured."
    },
    "EnableGitHub": {
      "Type": "String",
      "Default": "false",
      "AllowedValues": [
        "false",
        "true"
      ],
      "Description": "Enable signed GitHub push intake only after its sync-runtime key exists and webhooks for registered public source repositories are configured."
    },
    "ReceiverRoles": {
      "Type": "CommaDelimitedList",
      "Default": "",
      "Description": "Role names (not ARNs) of the destinations' own deploy roles, comma separated, that may put received and ping events on this bus. Empty grants nobody. One list, one policy: the hobby-scale shape."
    },
    "FeedbinConfig": {
      "Type": "String",
      "Default": "",
      "NoEcho": true,
      "Description": "Private JSON connection configuration for the Feedbin starred-feed importer: url, mode (preview or active), initial (import or future), shared (boolean), tags (array). Empty disables it. The Pinboard credential remains a Secrets Manager dynamic reference."
    },
    "LinksBookmarkMode": {
      "Type": "String",
      "Default": "off",
      "AllowedValues": [
        "off",
        "rehearsal",
        "active"
      ],
      "Description": "Pinboard public bookmark subscriber: off resolves no key, rehearsal dispatches only a dry run, active captures public bookmarks and starts their publication."
    }
  },
  "Conditions": {
    "HasCode": {
      "Fn::Not": [
        {
          "Fn::Equals": [
            {
              "Ref": "CodeKey"
            },
            ""
          ]
        }
      ]
    },
    "HasCodeVersion": {
      "Fn::Not": [
        {
          "Fn::Equals": [
            {
              "Ref": "CodeVersion"
            },
            ""
          ]
        }
      ]
    },
    "HasCertificate": {
      "Fn::Not": [
        {
          "Fn::Equals": [
            {
              "Ref": "CertificateArn"
            },
            ""
          ]
        }
      ]
    },
    "HasPublisher": {
      "Fn::Not": [
        {
          "Fn::Equals": [
            {
              "Ref": "PublisherUser"
            },
            ""
          ]
        }
      ]
    },
    "HasRuntimeSecret": {
      "Fn::Not": [
        {
          "Fn::Equals": [
            {
              "Ref": "RuntimeSecret"
            },
            ""
          ]
        }
      ]
    },
    "HasButtondownKey": {
      "Fn::And": [
        {
          "Condition": "HasRuntimeSecret"
        },
        {
          "Fn::Equals": [
            {
              "Ref": "EnableButtondown"
            },
            "true"
          ]
        }
      ]
    },
    "HasGitHubKey": {
      "Fn::And": [
        {
          "Condition": "HasRuntimeSecret"
        },
        {
          "Fn::Equals": [
            {
              "Ref": "EnableGitHub"
            },
            "true"
          ]
        }
      ]
    },
    "HasReceivers": {
      "Fn::Not": [
        {
          "Fn::Equals": [
            {
              "Fn::Join": [
                ",",
                {
                  "Ref": "ReceiverRoles"
                }
              ]
            },
            ""
          ]
        }
      ]
    },
    "HasFeedbin": {
      "Fn::Not": [
        {
          "Fn::Equals": [
            {
              "Ref": "FeedbinConfig"
            },
            ""
          ]
        }
      ]
    },
    "HasLinksBookmarks": {
      "Fn::And": [
        {
          "Condition": "HasRuntimeSecret"
        },
        {
          "Fn::Not": [
            {
              "Fn::Equals": [
                {
                  "Ref": "LinksBookmarkMode"
                },
                "off"
              ]
            }
          ]
        }
      ]
    },
    "ActiveLinksBookmarks": {
      "Fn::Equals": [
        {
          "Ref": "LinksBookmarkMode"
        },
        "active"
      ]
    }
  },
  "Resources": {
    "CodeBucket": {
      "Type": "AWS::S3::Bucket",
      "DeletionPolicy": "Retain",
      "UpdateReplacePolicy": "Retain",
      "Properties": {
        "BucketName": {
          "Fn::Sub": "${AWS::StackName}-code-${AWS::AccountId}"
        },
        "VersioningConfiguration": {
          "Status": "Enabled"
        },
        "PublicAccessBlockConfiguration": {
          "BlockPublicAcls": true,
          "BlockPublicPolicy": true,
          "IgnorePublicAcls": true,
          "RestrictPublicBuckets": true
        },
        "BucketEncryption": {
          "ServerSideEncryptionConfiguration": [
            {
              "ServerSideEncryptionByDefault": {
                "SSEAlgorithm": "AES256"
              }
            }
          ]
        },
        "LifecycleConfiguration": {
          "Rules": [
            {
              "Id": "expire-old-packages",
              "Status": "Enabled",
              "NoncurrentVersionExpiration": {
                "NoncurrentDays": 30
              }
            },
            {
              "Id": "abort-incomplete-uploads",
              "Status": "Enabled",
              "AbortIncompleteMultipartUpload": {
                "DaysAfterInitiation": 7
              }
            }
          ]
        }
      }
    },
    "CodeBucketPolicy": {
      "Type": "AWS::S3::BucketPolicy",
      "Properties": {
        "Bucket": {
          "Ref": "CodeBucket"
        },
        "PolicyDocument": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Sid": "TLSOnly",
              "Effect": "Deny",
              "Principal": "*",
              "Action": "s3:*",
              "Resource": [
                {
                  "Fn::GetAtt": [
                    "CodeBucket",
                    "Arn"
                  ]
                },
                {
                  "Fn::Sub": "${CodeBucket.Arn}/*"
                }
              ],
              "Condition": {
                "Bool": {
                  "aws:SecureTransport": "false"
                }
              }
            }
          ]
        }
      }
    },
    "SiteBucket": {
      "Type": "AWS::S3::Bucket",
      "DeletionPolicy": "Retain",
      "UpdateReplacePolicy": "Retain",
      "Properties": {
        "BucketName": {
          "Fn::Sub": "${AWS::StackName}-site-${AWS::AccountId}"
        },
        "PublicAccessBlockConfiguration": {
          "BlockPublicAcls": true,
          "BlockPublicPolicy": true,
          "IgnorePublicAcls": true,
          "RestrictPublicBuckets": true
        },
        "BucketEncryption": {
          "ServerSideEncryptionConfiguration": [
            {
              "ServerSideEncryptionByDefault": {
                "SSEAlgorithm": "AES256"
              }
            }
          ]
        }
      }
    },
    "SiteBucketPolicy": {
      "Type": "AWS::S3::BucketPolicy",
      "Properties": {
        "Bucket": {
          "Ref": "SiteBucket"
        },
        "PolicyDocument": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Sid": "TLSOnly",
              "Effect": "Deny",
              "Principal": "*",
              "Action": "s3:*",
              "Resource": [
                {
                  "Fn::GetAtt": [
                    "SiteBucket",
                    "Arn"
                  ]
                },
                {
                  "Fn::Sub": "${SiteBucket.Arn}/*"
                }
              ],
              "Condition": {
                "Bool": {
                  "aws:SecureTransport": "false"
                }
              }
            },
            {
              "Sid": "CloudFrontReadsSite",
              "Effect": "Allow",
              "Principal": {
                "Service": "cloudfront.amazonaws.com"
              },
              "Action": "s3:GetObject",
              "Resource": {
                "Fn::Sub": "${SiteBucket.Arn}/*"
              },
              "Condition": {
                "StringEquals": {
                  "AWS:SourceArn": {
                    "Fn::Sub": "arn:aws:cloudfront::${AWS::AccountId}:distribution/${Distribution}"
                  }
                }
              }
            }
          ]
        }
      }
    },
    "Logs": {
      "Type": "AWS::Logs::LogGroup",
      "Properties": {
        "LogGroupName": {
          "Fn::Sub": "/aws/lambda/${AWS::StackName}"
        },
        "RetentionInDays": 30
      }
    },
    "PublishingBus": {
      "Type": "AWS::Events::EventBus",
      "Properties": {
        "Name": "thingelstad-publishing",
        "Description": "Public publishing and destination arrival receipts; the sync probe listens"
      }
    },
    "PublishingArchive": {
      "Type": "AWS::Events::Archive",
      "Properties": {
        "ArchiveName": "thingelstad-publishing",
        "Description": "Ninety days of published and received events, replayable",
        "SourceArn": {
          "Fn::GetAtt": [
            "PublishingBus",
            "Arn"
          ]
        },
        "EventPattern": {
          "detail-type": [
            "published",
            "received",
            "subscriber",
            "pushed",
            "activity",
            "refreshed",
            "bookmarks-ready"
          ],
          "source": [
            "wt-builder",
            "librarian",
            "thingy",
            "links",
            "weekly",
            "another",
            "microblog",
            "buttondown",
            "github",
            "xyz",
            "pinboard"
          ]
        },
        "RetentionDays": 90
      }
    },
    "PublisherPutEvents": {
      "Type": "AWS::IAM::ManagedPolicy",
      "Condition": "HasPublisher",
      "Properties": {
        "Description": "Put events on the thingelstad-publishing bus and nothing else",
        "Users": [
          {
            "Ref": "PublisherUser"
          }
        ],
        "PolicyDocument": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Sid": "PutPublishedEvents",
              "Effect": "Allow",
              "Action": "events:PutEvents",
              "Resource": {
                "Fn::GetAtt": [
                  "PublishingBus",
                  "Arn"
                ]
              },
              "Condition": {
                "StringEquals": {
                  "events:source": "wt-builder",
                  "events:detail-type": [
                    "published",
                    "ping"
                  ]
                }
              }
            }
          ]
        }
      }
    },
    "FollowUps": {
      "Type": "AWS::Scheduler::ScheduleGroup",
      "Properties": {
        "Name": {
          "Fn::Sub": "${AWS::StackName}-follow-ups"
        }
      }
    },
    "ExecutionRole": {
      "Type": "AWS::IAM::Role",
      "Properties": {
        "Description": "sync probe: writes the page and its facts to the site bucket, reads the Librarian artifact times, and makes its own follow-up schedules",
        "AssumeRolePolicyDocument": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Effect": "Allow",
              "Principal": {
                "Service": "lambda.amazonaws.com"
              },
              "Action": "sts:AssumeRole"
            }
          ]
        },
        "Policies": [
          {
            "PolicyName": "sync-probe",
            "PolicyDocument": {
              "Version": "2012-10-17",
              "Statement": [
                {
                  "Sid": "OwnLogs",
                  "Effect": "Allow",
                  "Action": [
                    "logs:CreateLogStream",
                    "logs:PutLogEvents"
                  ],
                  "Resource": {
                    "Fn::Sub": "${Logs.Arn}"
                  }
                },
                {
                  "Sid": "PublishAndReadSite",
                  "Effect": "Allow",
                  "Action": [
                    "s3:PutObject",
                    "s3:GetObject"
                  ],
                  "Resource": {
                    "Fn::Sub": "${SiteBucket.Arn}/*"
                  }
                },
                {
                  "Sid": "KnowSiteBucket",
                  "Effect": "Allow",
                  "Action": [
                    "s3:ListBucket"
                  ],
                  "Resource": {
                    "Fn::Sub": "${SiteBucket.Arn}"
                  }
                },
                {
                  "Sid": "ReadLibrarianArtifactTimes",
                  "Effect": "Allow",
                  "Action": [
                    "s3:GetObject"
                  ],
                  "Resource": "arn:aws:s3:::weekly-thing-librarian/artifacts/*"
                },
                {
                  "Sid": "AnnounceNewPublicBlogPosts",
                  "Effect": "Allow",
                  "Action": "events:PutEvents",
                  "Resource": {
                    "Fn::GetAtt": [
                      "PublishingBus",
                      "Arn"
                    ]
                  },
                  "Condition": {
                    "StringEquals": {
                      "events:source": "microblog",
                      "events:detail-type": "published"
                    }
                  }
                },
                {
                  "Fn::If": [
                    "HasLinksBookmarks",
                    {
                      "Sid": "CapturePublicBookmarks",
                      "Effect": "Allow",
                      "Action": "s3:PutObject",
                      "Resource": {
                        "Fn::Sub": "arn:${AWS::Partition}:s3:::links-storage-inbox-${AWS::AccountId}/bookmarks/*"
                      }
                    },
                    {
                      "Ref": "AWS::NoValue"
                    }
                  ]
                },
                {
                  "Sid": "AnnounceCapturedPublicBookmarks",
                  "Effect": "Allow",
                  "Action": "events:PutEvents",
                  "Resource": {
                    "Fn::GetAtt": [
                      "PublishingBus",
                      "Arn"
                    ]
                  },
                  "Condition": {
                    "StringEquals": {
                      "events:source": "pinboard",
                      "events:detail-type": [
                        "bookmarks-ready",
                        "ping"
                      ]
                    }
                  }
                }
              ]
            }
          }
        ]
      }
    },
    "Function": {
      "Type": "AWS::Lambda::Function",
      "Condition": "HasCode",
      "DependsOn": [
        "Logs"
      ],
      "Properties": {
        "FunctionName": {
          "Ref": "AWS::StackName"
        },
        "Description": "sync.thingelstad.xyz probe: reads what every system publishes and writes the sync page; runs on the clock and on every published event",
        "Runtime": "nodejs24.x",
        "Architectures": [
          "arm64"
        ],
        "Handler": "src/handler.handler",
        "MemorySize": 256,
        "Timeout": 300,
        "Role": {
          "Fn::GetAtt": [
            "ExecutionRole",
            "Arn"
          ]
        },
        "Code": {
          "S3Bucket": {
            "Ref": "CodeBucket"
          },
          "S3Key": {
            "Ref": "CodeKey"
          },
          "S3ObjectVersion": {
            "Fn::If": [
              "HasCodeVersion",
              {
                "Ref": "CodeVersion"
              },
              {
                "Ref": "AWS::NoValue"
              }
            ]
          }
        },
        "Environment": {
          "Variables": {
            "SYNC_CODE": {
              "Ref": "CodeKey"
            },
            "SITE_BUCKET": {
              "Ref": "SiteBucket"
            },
            "PINBOARD_API_TOKEN": {
              "Fn::If": [
                "HasRuntimeSecret",
                {
                  "Fn::Sub": "{{resolve:secretsmanager:${RuntimeSecret}:SecretString:pinboard_token}}"
                },
                {
                  "Ref": "AWS::NoValue"
                }
              ]
            },
            "FOLLOW_UP_GROUP": {
              "Ref": "FollowUps"
            },
            "SCHEDULER_ROLE_ARN": {
              "Fn::GetAtt": [
                "SchedulerRole",
                "Arn"
              ]
            },
            "PUBLISHING_BUS": {
              "Ref": "PublishingBus"
            },
            "MICROBLOG_API_KEY": {
              "Fn::If": [
                "HasRuntimeSecret",
                {
                  "Fn::Sub": "{{resolve:secretsmanager:${RuntimeSecret}:SecretString:microblog_api_key}}"
                },
                {
                  "Ref": "AWS::NoValue"
                }
              ]
            },
            "FEEDBIN_CONFIG": {
              "Fn::If": [
                "HasFeedbin",
                {
                  "Ref": "FeedbinConfig"
                },
                {
                  "Ref": "AWS::NoValue"
                }
              ]
            },
            "LINKS_BOOKMARK_INBOX": {
              "Fn::If": [
                "ActiveLinksBookmarks",
                {
                  "Fn::Sub": "links-storage-inbox-${AWS::AccountId}"
                },
                {
                  "Ref": "AWS::NoValue"
                }
              ]
            }
          }
        },
        "ReservedConcurrentExecutions": 1
      }
    },
    "PublishedRule": {
      "Type": "AWS::Events::Rule",
      "Condition": "HasCode",
      "Properties": {
        "Name": {
          "Fn::Sub": "${AWS::StackName}-published"
        },
        "Description": "Published and received events run the sync probe",
        "EventBusName": {
          "Ref": "PublishingBus"
        },
        "EventPattern": {
          "detail-type": [
            "published",
            "received"
          ],
          "source": [
            "wt-builder",
            "librarian",
            "thingy",
            "links",
            "weekly",
            "another",
            "microblog"
          ]
        },
        "State": "ENABLED",
        "Targets": [
          {
            "Id": "probe",
            "Arn": {
              "Fn::GetAtt": [
                "Function",
                "Arn"
              ]
            },
            "RetryPolicy": {
              "MaximumRetryAttempts": 3,
              "MaximumEventAgeInSeconds": 3600
            }
          }
        ]
      }
    },
    "PublishedInvoke": {
      "Type": "AWS::Lambda::Permission",
      "Condition": "HasCode",
      "Properties": {
        "Action": "lambda:InvokeFunction",
        "FunctionName": {
          "Ref": "Function"
        },
        "Principal": "events.amazonaws.com",
        "SourceArn": {
          "Fn::GetAtt": [
            "PublishedRule",
            "Arn"
          ]
        },
        "SourceAccount": {
          "Ref": "AWS::AccountId"
        }
      }
    },
    "SchedulerRole": {
      "Type": "AWS::IAM::Role",
      "Condition": "HasCode",
      "Properties": {
        "Description": "EventBridge Scheduler starts the sync probe",
        "AssumeRolePolicyDocument": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Effect": "Allow",
              "Principal": {
                "Service": "scheduler.amazonaws.com"
              },
              "Action": "sts:AssumeRole",
              "Condition": {
                "StringEquals": {
                  "aws:SourceAccount": {
                    "Ref": "AWS::AccountId"
                  }
                }
              }
            }
          ]
        },
        "Policies": [
          {
            "PolicyName": "invoke-sync-probe",
            "PolicyDocument": {
              "Version": "2012-10-17",
              "Statement": [
                {
                  "Effect": "Allow",
                  "Action": "lambda:InvokeFunction",
                  "Resource": {
                    "Fn::Sub": "arn:aws:lambda:${AWS::Region}:${AWS::AccountId}:function:${AWS::StackName}"
                  }
                }
              ]
            }
          }
        ]
      }
    },
    "FollowUpPolicy": {
      "Type": "AWS::IAM::Policy",
      "Condition": "HasCode",
      "Properties": {
        "PolicyName": "sync-follow-ups",
        "Roles": [
          {
            "Ref": "ExecutionRole"
          }
        ],
        "PolicyDocument": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Sid": "OwnFollowUps",
              "Effect": "Allow",
              "Action": [
                "scheduler:CreateSchedule",
                "scheduler:GetSchedule",
                "scheduler:DeleteSchedule"
              ],
              "Resource": {
                "Fn::Sub": "arn:aws:scheduler:${AWS::Region}:${AWS::AccountId}:schedule/${FollowUps}/*"
              }
            },
            {
              "Sid": "HandTheSchedulerItsRole",
              "Effect": "Allow",
              "Action": "iam:PassRole",
              "Resource": {
                "Fn::GetAtt": [
                  "SchedulerRole",
                  "Arn"
                ]
              },
              "Condition": {
                "StringEquals": {
                  "iam:PassedToService": "scheduler.amazonaws.com"
                }
              }
            }
          ]
        }
      }
    },
    "Schedule": {
      "Type": "AWS::Scheduler::Schedule",
      "Condition": "HasCode",
      "Properties": {
        "Name": {
          "Fn::Sub": "${AWS::StackName}-probe"
        },
        "Description": "Run the sync probe every half hour",
        "ScheduleExpression": "rate(30 minutes)",
        "FlexibleTimeWindow": {
          "Mode": "OFF"
        },
        "State": "ENABLED",
        "Target": {
          "Arn": {
            "Fn::GetAtt": [
              "Function",
              "Arn"
            ]
          },
          "RoleArn": {
            "Fn::GetAtt": [
              "SchedulerRole",
              "Arn"
            ]
          },
          "RetryPolicy": {
            "MaximumRetryAttempts": 1,
            "MaximumEventAgeInSeconds": 600
          },
          "Input": "{\"clock\": true}"
        }
      }
    },
    "OriginAccess": {
      "Type": "AWS::CloudFront::OriginAccessControl",
      "Properties": {
        "OriginAccessControlConfig": {
          "Name": {
            "Fn::Sub": "${AWS::StackName}-site"
          },
          "Description": "CloudFront signs its reads of the sync site bucket",
          "OriginAccessControlOriginType": "s3",
          "SigningBehavior": "always",
          "SigningProtocol": "sigv4"
        }
      }
    },
    "CachePolicy": {
      "Type": "AWS::CloudFront::CachePolicy",
      "Properties": {
        "CachePolicyConfig": {
          "Name": {
            "Fn::Sub": "${AWS::StackName}-site"
          },
          "Comment": "sync page: short cache, the probe rewrites it every half hour",
          "MinTTL": 0,
          "DefaultTTL": 60,
          "MaxTTL": 300,
          "ParametersInCacheKeyAndForwardedToOrigin": {
            "EnableAcceptEncodingGzip": true,
            "EnableAcceptEncodingBrotli": true,
            "CookiesConfig": {
              "CookieBehavior": "none"
            },
            "HeadersConfig": {
              "HeaderBehavior": "none"
            },
            "QueryStringsConfig": {
              "QueryStringBehavior": "none"
            }
          }
        }
      }
    },
    "IndexFunction": {
      "Type": "AWS::CloudFront::Function",
      "Properties": {
        "Name": {
          "Fn::Sub": "${AWS::StackName}-index"
        },
        "AutoPublish": true,
        "FunctionConfig": {
          "Comment": "Map directory paths to their index.html",
          "Runtime": "cloudfront-js-2.0"
        },
        "FunctionCode": "function handler(event) {\n  var request = event.request;\n  var uri = request.uri;\n  if (uri.endsWith('/')) {\n    request.uri = uri + 'index.html';\n  } else if (!uri.includes('.')) {\n    request.uri = uri + '/index.html';\n  }\n  return request;\n}\n"
      }
    },
    "Distribution": {
      "Type": "AWS::CloudFront::Distribution",
      "Properties": {
        "DistributionConfig": {
          "Enabled": true,
          "Comment": "sync.thingelstad.xyz",
          "HttpVersion": "http2and3",
          "IPV6Enabled": true,
          "PriceClass": "PriceClass_100",
          "DefaultRootObject": "index.html",
          "Aliases": {
            "Fn::If": [
              "HasCertificate",
              [
                "sync.thingelstad.xyz"
              ],
              {
                "Ref": "AWS::NoValue"
              }
            ]
          },
          "ViewerCertificate": {
            "Fn::If": [
              "HasCertificate",
              {
                "AcmCertificateArn": {
                  "Ref": "CertificateArn"
                },
                "SslSupportMethod": "sni-only",
                "MinimumProtocolVersion": "TLSv1.2_2021"
              },
              {
                "CloudFrontDefaultCertificate": true
              }
            ]
          },
          "Origins": [
            {
              "Id": "site",
              "DomainName": {
                "Fn::GetAtt": [
                  "SiteBucket",
                  "RegionalDomainName"
                ]
              },
              "OriginAccessControlId": {
                "Fn::GetAtt": [
                  "OriginAccess",
                  "Id"
                ]
              },
              "S3OriginConfig": {
                "OriginAccessIdentity": ""
              }
            }
          ],
          "DefaultCacheBehavior": {
            "TargetOriginId": "site",
            "ViewerProtocolPolicy": "redirect-to-https",
            "AllowedMethods": [
              "GET",
              "HEAD"
            ],
            "CachedMethods": [
              "GET",
              "HEAD"
            ],
            "Compress": true,
            "CachePolicyId": {
              "Ref": "CachePolicy"
            },
            "ResponseHeadersPolicyId": "67f7725c-6f97-4210-82d7-5512b31e9d03",
            "FunctionAssociations": [
              {
                "EventType": "viewer-request",
                "FunctionARN": {
                  "Fn::GetAtt": [
                    "IndexFunction",
                    "FunctionARN"
                  ]
                }
              }
            ]
          },
          "CustomErrorResponses": [
            {
              "ErrorCode": 403,
              "ResponseCode": 404,
              "ResponsePagePath": "/404.html",
              "ErrorCachingMinTTL": 60
            },
            {
              "ErrorCode": 404,
              "ResponseCode": 404,
              "ResponsePagePath": "/404.html",
              "ErrorCachingMinTTL": 60
            }
          ]
        }
      }
    },
    "IntakeLogs": {
      "Type": "AWS::Logs::LogGroup",
      "Condition": "HasCode",
      "Properties": {
        "LogGroupName": {
          "Fn::Sub": "/aws/lambda/${AWS::StackName}-intake"
        },
        "RetentionInDays": 30
      }
    },
    "IntakeRole": {
      "Type": "AWS::IAM::Role",
      "Condition": "HasCode",
      "Properties": {
        "Description": "Signed webhook intake: own logs and scoped Buttondown and GitHub metadata on the publishing bus only",
        "AssumeRolePolicyDocument": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Effect": "Allow",
              "Principal": {
                "Service": "lambda.amazonaws.com"
              },
              "Action": "sts:AssumeRole"
            }
          ]
        },
        "Policies": [
          {
            "PolicyName": "sync-intake",
            "PolicyDocument": {
              "Version": "2012-10-17",
              "Statement": [
                {
                  "Sid": "OwnLogs",
                  "Effect": "Allow",
                  "Action": [
                    "logs:CreateLogStream",
                    "logs:PutLogEvents"
                  ],
                  "Resource": {
                    "Fn::GetAtt": [
                      "IntakeLogs",
                      "Arn"
                    ]
                  }
                },
                {
                  "Sid": "ButtondownSubscriberSignals",
                  "Effect": "Allow",
                  "Action": "events:PutEvents",
                  "Resource": {
                    "Fn::GetAtt": [
                      "PublishingBus",
                      "Arn"
                    ]
                  },
                  "Condition": {
                    "StringEquals": {
                      "events:source": "buttondown",
                      "events:detail-type": "subscriber"
                    }
                  }
                },
                {
                  "Sid": "GitHubSourcePushes",
                  "Effect": "Allow",
                  "Action": "events:PutEvents",
                  "Resource": {
                    "Fn::GetAtt": [
                      "PublishingBus",
                      "Arn"
                    ]
                  },
                  "Condition": {
                    "StringEquals": {
                      "events:source": "github",
                      "events:detail-type": "pushed"
                    }
                  }
                }
              ]
            }
          }
        ]
      }
    },
    "IntakeFunction": {
      "Type": "AWS::Lambda::Function",
      "Condition": "HasCode",
      "DependsOn": [
        "IntakeLogs"
      ],
      "Properties": {
        "FunctionName": {
          "Fn::Sub": "${AWS::StackName}-intake"
        },
        "Description": "Verify webhook raw-body signatures and queue metadata-only events; senders are disabled until explicitly enabled",
        "Runtime": "nodejs24.x",
        "Handler": "src/intake-handler.handler",
        "Architectures": [
          "arm64"
        ],
        "MemorySize": 256,
        "Timeout": 5,
        "ReservedConcurrentExecutions": 2,
        "Role": {
          "Fn::GetAtt": [
            "IntakeRole",
            "Arn"
          ]
        },
        "Code": {
          "S3Bucket": {
            "Ref": "CodeBucket"
          },
          "S3Key": {
            "Ref": "CodeKey"
          },
          "S3ObjectVersion": {
            "Fn::If": [
              "HasCodeVersion",
              {
                "Ref": "CodeVersion"
              },
              {
                "Ref": "AWS::NoValue"
              }
            ]
          }
        },
        "Environment": {
          "Variables": {
            "PUBLISHING_BUS": {
              "Ref": "PublishingBus"
            },
            "ENABLE_BUTTONDOWN": {
              "Ref": "EnableButtondown"
            },
            "BUTTONDOWN_WEBHOOK_SIGNING_KEY": {
              "Fn::If": [
                "HasButtondownKey",
                {
                  "Fn::Sub": "{{resolve:secretsmanager:${RuntimeSecret}:SecretString:buttondown_webhook_signing_key}}"
                },
                {
                  "Ref": "AWS::NoValue"
                }
              ]
            },
            "ENABLE_GITHUB": {
              "Ref": "EnableGitHub"
            },
            "GITHUB_WEBHOOK_SIGNING_KEY": {
              "Fn::If": [
                "HasGitHubKey",
                {
                  "Fn::Sub": "{{resolve:secretsmanager:${RuntimeSecret}:SecretString:github_webhook_signing_key}}"
                },
                {
                  "Ref": "AWS::NoValue"
                }
              ]
            }
          }
        }
      }
    },
    "IntakeUrl": {
      "Type": "AWS::Lambda::Url",
      "Condition": "HasCode",
      "Properties": {
        "TargetFunctionArn": {
          "Fn::GetAtt": [
            "IntakeFunction",
            "Arn"
          ]
        },
        "AuthType": "NONE",
        "InvokeMode": "BUFFERED"
      }
    },
    "IntakeUrlInvoke": {
      "Type": "AWS::Lambda::Permission",
      "Condition": "HasCode",
      "Properties": {
        "FunctionName": {
          "Ref": "IntakeFunction"
        },
        "Action": "lambda:InvokeFunctionUrl",
        "Principal": "*",
        "FunctionUrlAuthType": "NONE"
      }
    },
    "IntakeFunctionInvoke": {
      "Type": "AWS::Lambda::Permission",
      "Condition": "HasCode",
      "Properties": {
        "FunctionName": {
          "Ref": "IntakeFunction"
        },
        "Action": "lambda:InvokeFunction",
        "Principal": "*",
        "InvokedViaFunctionUrl": true
      }
    },
    "ReceiverPutEvents": {
      "Type": "AWS::IAM::ManagedPolicy",
      "Condition": "HasReceivers",
      "Properties": {
        "Description": "Destination arrival receipts (received, ping) on the thingelstad-publishing bus and nothing else",
        "Roles": {
          "Ref": "ReceiverRoles"
        },
        "PolicyDocument": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Effect": "Allow",
              "Action": "events:PutEvents",
              "Resource": {
                "Fn::GetAtt": [
                  "PublishingBus",
                  "Arn"
                ]
              },
              "Condition": {
                "StringEquals": {
                  "events:source": [
                    "weekly",
                    "another",
                    "librarian",
                    "thingy",
                    "links",
                    "xyz"
                  ],
                  "events:detail-type": [
                    "received",
                    "ping"
                  ]
                }
              }
            }
          ]
        }
      }
    },
    "LinksBookmarkConnection": {
      "Type": "AWS::Events::Connection",
      "Condition": "HasLinksBookmarks",
      "Properties": {
        "AuthorizationType": "API_KEY",
        "AuthParameters": {
          "ApiKeyAuthParameters": {
            "ApiKeyName": "Authorization",
            "ApiKeyValue": {
              "Fn::Sub": "Bearer {{resolve:secretsmanager:${RuntimeSecret}:SecretString:github_links_actions_token}}"
            }
          }
        }
      }
    },
    "LinksBookmarkDestination": {
      "Type": "AWS::Events::ApiDestination",
      "Condition": "HasLinksBookmarks",
      "Properties": {
        "ConnectionArn": {
          "Fn::GetAtt": [
            "LinksBookmarkConnection",
            "Arn"
          ]
        },
        "HttpMethod": "POST",
        "InvocationEndpoint": "https://api.github.com/repos/jthingelstad/links.thingelstad.xyz/actions/workflows/sync-bookmarks.yml/dispatches",
        "InvocationRateLimitPerSecond": 1
      }
    },
    "LinksBookmarkInvokeRole": {
      "Type": "AWS::IAM::Role",
      "Condition": "HasLinksBookmarks",
      "Properties": {
        "AssumeRolePolicyDocument": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Effect": "Allow",
              "Principal": {
                "Service": "events.amazonaws.com"
              },
              "Action": "sts:AssumeRole"
            }
          ]
        },
        "Policies": [
          {
            "PolicyName": "invoke-links-bookmarks",
            "PolicyDocument": {
              "Version": "2012-10-17",
              "Statement": [
                {
                  "Effect": "Allow",
                  "Action": "events:InvokeApiDestination",
                  "Resource": {
                    "Fn::GetAtt": [
                      "LinksBookmarkDestination",
                      "Arn"
                    ]
                  }
                }
              ]
            }
          }
        ]
      }
    },
    "LinksBookmarkRule": {
      "Type": "AWS::Events::Rule",
      "Condition": "HasLinksBookmarks",
      "Properties": {
        "Name": {
          "Fn::Sub": "${AWS::StackName}-links-bookmarks"
        },
        "EventBusName": {
          "Ref": "PublishingBus"
        },
        "State": "ENABLED",
        "EventPattern": {
          "source": [
            "pinboard"
          ],
          "detail-type": {
            "Fn::If": [
              "ActiveLinksBookmarks",
              [
                "bookmarks-ready"
              ],
              [
                "ping"
              ]
            ]
          }
        },
        "Targets": [
          {
            "Id": "links-bookmarks",
            "Arn": {
              "Fn::GetAtt": [
                "LinksBookmarkDestination",
                "Arn"
              ]
            },
            "RoleArn": {
              "Fn::GetAtt": [
                "LinksBookmarkInvokeRole",
                "Arn"
              ]
            },
            "Input": {
              "Fn::If": [
                "ActiveLinksBookmarks",
                "{\"ref\":\"main\",\"inputs\":{\"dry_run\":\"false\"}}",
                "{\"ref\":\"main\",\"inputs\":{\"dry_run\":\"true\"}}"
              ]
            },
            "HttpParameters": {
              "HeaderParameters": {
                "Accept": "application/vnd.github+json",
                "X-GitHub-Api-Version": "2026-03-10"
              }
            },
            "RetryPolicy": {
              "MaximumEventAgeInSeconds": 3600,
              "MaximumRetryAttempts": 10
            }
          }
        ]
      }
    }
  },
  "Outputs": {
    "CodeBucket": {
      "Value": {
        "Ref": "CodeBucket"
      }
    },
    "SiteBucket": {
      "Value": {
        "Ref": "SiteBucket"
      }
    },
    "FunctionName": {
      "Value": {
        "Fn::If": [
          "HasCode",
          {
            "Ref": "Function"
          },
          ""
        ]
      }
    },
    "DistributionId": {
      "Value": {
        "Ref": "Distribution"
      }
    },
    "DistributionDomain": {
      "Value": {
        "Fn::GetAtt": [
          "Distribution",
          "DomainName"
        ]
      }
    },
    "PublishingBus": {
      "Value": {
        "Ref": "PublishingBus"
      }
    },
    "PublishingBusArn": {
      "Value": {
        "Fn::GetAtt": [
          "PublishingBus",
          "Arn"
        ]
      }
    },
    "FollowUpGroup": {
      "Value": {
        "Ref": "FollowUps"
      }
    },
    "IntakeUrl": {
      "Value": {
        "Fn::If": [
          "HasCode",
          {
            "Fn::GetAtt": [
              "IntakeUrl",
              "FunctionUrl"
            ]
          },
          ""
        ]
      },
      "Description": "Append /buttondown or /github; each sender requires its explicit flag and signing key."
    }
  }
}
