{
  "AWSTemplateFormatVersion": "2010-09-09",
  "Description": "sync.thingelstad.xyz: the publishing bus, the sync probe on a half-hour schedule and on every published event, and the page it publishes",
  "Parameters": {
    "CodeKey": {
      "Type": "String",
      "Default": "",
      "Description": "S3 key of the packaged probe in the code bucket; empty on the first apply, which creates the buckets and roles only"
    },
    "CodeVersion": {
      "Type": "String",
      "Default": "",
      "Description": "Optional S3 object version of the packaged probe"
    },
    "CertificateArn": {
      "Type": "String",
      "Default": "",
      "Description": "ACM certificate for sync.thingelstad.xyz in us-east-1; empty serves the CloudFront domain only"
    },
    "PublisherUser": {
      "Type": "String",
      "Default": "wt-archive",
      "Description": "IAM user WT Builder signs its AWS calls with; it may put events on the publishing bus. Empty grants nobody."
    },
    "RuntimeSecret": {
      "Type": "String",
      "Default": "",
      "Description": "Name of the sync app's Secrets Manager secret (sync-runtime). Keys: pinboard_token (the Pinboard fact) and microblog_api_key (micro.blog's API, for the readers to come). Empty leaves every fact that needs a secret unread."
    }
  },
  "Conditions": {
    "HasCode": {
      "Fn::Not": [
        {
          "Fn::Equals": [
            {
              "Ref": "CodeKey"
            },
            ""
          ]
        }
      ]
    },
    "HasCodeVersion": {
      "Fn::Not": [
        {
          "Fn::Equals": [
            {
              "Ref": "CodeVersion"
            },
            ""
          ]
        }
      ]
    },
    "HasCertificate": {
      "Fn::Not": [
        {
          "Fn::Equals": [
            {
              "Ref": "CertificateArn"
            },
            ""
          ]
        }
      ]
    },
    "HasPublisher": {
      "Fn::Not": [
        {
          "Fn::Equals": [
            {
              "Ref": "PublisherUser"
            },
            ""
          ]
        }
      ]
    },
    "HasRuntimeSecret": {
      "Fn::Not": [
        {
          "Fn::Equals": [
            {
              "Ref": "RuntimeSecret"
            },
            ""
          ]
        }
      ]
    }
  },
  "Resources": {
    "CodeBucket": {
      "Type": "AWS::S3::Bucket",
      "DeletionPolicy": "Retain",
      "UpdateReplacePolicy": "Retain",
      "Properties": {
        "BucketName": {
          "Fn::Sub": "${AWS::StackName}-code-${AWS::AccountId}"
        },
        "VersioningConfiguration": {
          "Status": "Enabled"
        },
        "PublicAccessBlockConfiguration": {
          "BlockPublicAcls": true,
          "BlockPublicPolicy": true,
          "IgnorePublicAcls": true,
          "RestrictPublicBuckets": true
        },
        "BucketEncryption": {
          "ServerSideEncryptionConfiguration": [
            {
              "ServerSideEncryptionByDefault": {
                "SSEAlgorithm": "AES256"
              }
            }
          ]
        },
        "LifecycleConfiguration": {
          "Rules": [
            {
              "Id": "expire-old-packages",
              "Status": "Enabled",
              "NoncurrentVersionExpiration": {
                "NoncurrentDays": 30
              }
            },
            {
              "Id": "abort-incomplete-uploads",
              "Status": "Enabled",
              "AbortIncompleteMultipartUpload": {
                "DaysAfterInitiation": 7
              }
            }
          ]
        }
      }
    },
    "CodeBucketPolicy": {
      "Type": "AWS::S3::BucketPolicy",
      "Properties": {
        "Bucket": {
          "Ref": "CodeBucket"
        },
        "PolicyDocument": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Sid": "TLSOnly",
              "Effect": "Deny",
              "Principal": "*",
              "Action": "s3:*",
              "Resource": [
                {
                  "Fn::GetAtt": [
                    "CodeBucket",
                    "Arn"
                  ]
                },
                {
                  "Fn::Sub": "${CodeBucket.Arn}/*"
                }
              ],
              "Condition": {
                "Bool": {
                  "aws:SecureTransport": "false"
                }
              }
            }
          ]
        }
      }
    },
    "SiteBucket": {
      "Type": "AWS::S3::Bucket",
      "DeletionPolicy": "Retain",
      "UpdateReplacePolicy": "Retain",
      "Properties": {
        "BucketName": {
          "Fn::Sub": "${AWS::StackName}-site-${AWS::AccountId}"
        },
        "PublicAccessBlockConfiguration": {
          "BlockPublicAcls": true,
          "BlockPublicPolicy": true,
          "IgnorePublicAcls": true,
          "RestrictPublicBuckets": true
        },
        "BucketEncryption": {
          "ServerSideEncryptionConfiguration": [
            {
              "ServerSideEncryptionByDefault": {
                "SSEAlgorithm": "AES256"
              }
            }
          ]
        }
      }
    },
    "SiteBucketPolicy": {
      "Type": "AWS::S3::BucketPolicy",
      "Properties": {
        "Bucket": {
          "Ref": "SiteBucket"
        },
        "PolicyDocument": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Sid": "TLSOnly",
              "Effect": "Deny",
              "Principal": "*",
              "Action": "s3:*",
              "Resource": [
                {
                  "Fn::GetAtt": [
                    "SiteBucket",
                    "Arn"
                  ]
                },
                {
                  "Fn::Sub": "${SiteBucket.Arn}/*"
                }
              ],
              "Condition": {
                "Bool": {
                  "aws:SecureTransport": "false"
                }
              }
            },
            {
              "Sid": "CloudFrontReadsSite",
              "Effect": "Allow",
              "Principal": {
                "Service": "cloudfront.amazonaws.com"
              },
              "Action": "s3:GetObject",
              "Resource": {
                "Fn::Sub": "${SiteBucket.Arn}/*"
              },
              "Condition": {
                "StringEquals": {
                  "AWS:SourceArn": {
                    "Fn::Sub": "arn:aws:cloudfront::${AWS::AccountId}:distribution/${Distribution}"
                  }
                }
              }
            }
          ]
        }
      }
    },
    "Logs": {
      "Type": "AWS::Logs::LogGroup",
      "Properties": {
        "LogGroupName": {
          "Fn::Sub": "/aws/lambda/${AWS::StackName}"
        },
        "RetentionInDays": 30
      }
    },
    "PublishingBus": {
      "Type": "AWS::Events::EventBus",
      "Properties": {
        "Name": "thingelstad-publishing",
        "Description": "Public publishing and destination arrival receipts; the sync probe listens"
      }
    },
    "PublishingArchive": {
      "Type": "AWS::Events::Archive",
      "Properties": {
        "ArchiveName": "thingelstad-publishing",
        "Description": "Ninety days of published and received events, replayable",
        "SourceArn": {
          "Fn::GetAtt": [
            "PublishingBus",
            "Arn"
          ]
        },
        "EventPattern": {
          "detail-type": [
            "published",
            "received"
          ],
          "source": [
            "wt-builder",
            "librarian",
            "thingy",
            "links",
            "weekly",
            "another",
            "microblog"
          ]
        },
        "RetentionDays": 90
      }
    },
    "PublisherPutEvents": {
      "Type": "AWS::IAM::ManagedPolicy",
      "Condition": "HasPublisher",
      "Properties": {
        "Description": "Put events on the thingelstad-publishing bus and nothing else",
        "Users": [
          {
            "Ref": "PublisherUser"
          }
        ],
        "PolicyDocument": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Sid": "PutPublishedEvents",
              "Effect": "Allow",
              "Action": "events:PutEvents",
              "Resource": {
                "Fn::GetAtt": [
                  "PublishingBus",
                  "Arn"
                ]
              },
              "Condition": {
                "StringEquals": {
                  "events:source": "wt-builder",
                  "events:detail-type": [
                    "published",
                    "ping"
                  ]
                }
              }
            }
          ]
        }
      }
    },
    "FollowUps": {
      "Type": "AWS::Scheduler::ScheduleGroup",
      "Properties": {
        "Name": {
          "Fn::Sub": "${AWS::StackName}-follow-ups"
        }
      }
    },
    "ExecutionRole": {
      "Type": "AWS::IAM::Role",
      "Properties": {
        "Description": "sync probe: writes the page and its facts to the site bucket, reads the Librarian artifact times, and makes its own follow-up schedules",
        "AssumeRolePolicyDocument": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Effect": "Allow",
              "Principal": {
                "Service": "lambda.amazonaws.com"
              },
              "Action": "sts:AssumeRole"
            }
          ]
        },
        "Policies": [
          {
            "PolicyName": "sync-probe",
            "PolicyDocument": {
              "Version": "2012-10-17",
              "Statement": [
                {
                  "Sid": "OwnLogs",
                  "Effect": "Allow",
                  "Action": [
                    "logs:CreateLogStream",
                    "logs:PutLogEvents"
                  ],
                  "Resource": {
                    "Fn::Sub": "${Logs.Arn}"
                  }
                },
                {
                  "Sid": "PublishAndReadSite",
                  "Effect": "Allow",
                  "Action": [
                    "s3:PutObject",
                    "s3:GetObject"
                  ],
                  "Resource": {
                    "Fn::Sub": "${SiteBucket.Arn}/*"
                  }
                },
                {
                  "Sid": "KnowSiteBucket",
                  "Effect": "Allow",
                  "Action": [
                    "s3:ListBucket"
                  ],
                  "Resource": {
                    "Fn::Sub": "${SiteBucket.Arn}"
                  }
                },
                {
                  "Sid": "ReadLibrarianArtifactTimes",
                  "Effect": "Allow",
                  "Action": [
                    "s3:GetObject"
                  ],
                  "Resource": "arn:aws:s3:::weekly-thing-librarian/artifacts/*"
                },
                {
                  "Sid": "AnnounceNewPublicBlogPosts",
                  "Effect": "Allow",
                  "Action": "events:PutEvents",
                  "Resource": {
                    "Fn::GetAtt": [
                      "PublishingBus",
                      "Arn"
                    ]
                  },
                  "Condition": {
                    "StringEquals": {
                      "events:source": "microblog",
                      "events:detail-type": "published"
                    }
                  }
                }
              ]
            }
          }
        ]
      }
    },
    "Function": {
      "Type": "AWS::Lambda::Function",
      "Condition": "HasCode",
      "DependsOn": [
        "Logs"
      ],
      "Properties": {
        "FunctionName": {
          "Ref": "AWS::StackName"
        },
        "Description": "sync.thingelstad.xyz probe: reads what every system publishes and writes the sync page; runs on the clock and on every published event",
        "Runtime": "nodejs24.x",
        "Architectures": [
          "arm64"
        ],
        "Handler": "src/handler.handler",
        "MemorySize": 256,
        "Timeout": 120,
        "Role": {
          "Fn::GetAtt": [
            "ExecutionRole",
            "Arn"
          ]
        },
        "Code": {
          "S3Bucket": {
            "Ref": "CodeBucket"
          },
          "S3Key": {
            "Ref": "CodeKey"
          },
          "S3ObjectVersion": {
            "Fn::If": [
              "HasCodeVersion",
              {
                "Ref": "CodeVersion"
              },
              {
                "Ref": "AWS::NoValue"
              }
            ]
          }
        },
        "Environment": {
          "Variables": {
            "SYNC_CODE": {
              "Ref": "CodeKey"
            },
            "SITE_BUCKET": {
              "Ref": "SiteBucket"
            },
            "PINBOARD_API_TOKEN": {
              "Fn::If": [
                "HasRuntimeSecret",
                {
                  "Fn::Sub": "{{resolve:secretsmanager:${RuntimeSecret}:SecretString:pinboard_token}}"
                },
                {
                  "Ref": "AWS::NoValue"
                }
              ]
            },
            "FOLLOW_UP_GROUP": {
              "Ref": "FollowUps"
            },
            "SCHEDULER_ROLE_ARN": {
              "Fn::GetAtt": [
                "SchedulerRole",
                "Arn"
              ]
            },
            "PUBLISHING_BUS": {
              "Ref": "PublishingBus"
            },
            "MICROBLOG_API_KEY": {
              "Fn::If": [
                "HasRuntimeSecret",
                {
                  "Fn::Sub": "{{resolve:secretsmanager:${RuntimeSecret}:SecretString:microblog_api_key}}"
                },
                {
                  "Ref": "AWS::NoValue"
                }
              ]
            }
          }
        },
        "ReservedConcurrentExecutions": 1
      }
    },
    "PublishedRule": {
      "Type": "AWS::Events::Rule",
      "Condition": "HasCode",
      "Properties": {
        "Name": {
          "Fn::Sub": "${AWS::StackName}-published"
        },
        "Description": "Published and received events run the sync probe",
        "EventBusName": {
          "Ref": "PublishingBus"
        },
        "EventPattern": {
          "detail-type": [
            "published",
            "received"
          ],
          "source": [
            "wt-builder",
            "librarian",
            "thingy",
            "links",
            "weekly",
            "another",
            "microblog"
          ]
        },
        "State": "ENABLED",
        "Targets": [
          {
            "Id": "probe",
            "Arn": {
              "Fn::GetAtt": [
                "Function",
                "Arn"
              ]
            },
            "RetryPolicy": {
              "MaximumRetryAttempts": 3,
              "MaximumEventAgeInSeconds": 3600
            }
          }
        ]
      }
    },
    "PublishedInvoke": {
      "Type": "AWS::Lambda::Permission",
      "Condition": "HasCode",
      "Properties": {
        "Action": "lambda:InvokeFunction",
        "FunctionName": {
          "Ref": "Function"
        },
        "Principal": "events.amazonaws.com",
        "SourceArn": {
          "Fn::GetAtt": [
            "PublishedRule",
            "Arn"
          ]
        },
        "SourceAccount": {
          "Ref": "AWS::AccountId"
        }
      }
    },
    "SchedulerRole": {
      "Type": "AWS::IAM::Role",
      "Condition": "HasCode",
      "Properties": {
        "Description": "EventBridge Scheduler starts the sync probe",
        "AssumeRolePolicyDocument": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Effect": "Allow",
              "Principal": {
                "Service": "scheduler.amazonaws.com"
              },
              "Action": "sts:AssumeRole",
              "Condition": {
                "StringEquals": {
                  "aws:SourceAccount": {
                    "Ref": "AWS::AccountId"
                  }
                }
              }
            }
          ]
        },
        "Policies": [
          {
            "PolicyName": "invoke-sync-probe",
            "PolicyDocument": {
              "Version": "2012-10-17",
              "Statement": [
                {
                  "Effect": "Allow",
                  "Action": "lambda:InvokeFunction",
                  "Resource": {
                    "Fn::Sub": "arn:aws:lambda:${AWS::Region}:${AWS::AccountId}:function:${AWS::StackName}"
                  }
                }
              ]
            }
          }
        ]
      }
    },
    "FollowUpPolicy": {
      "Type": "AWS::IAM::Policy",
      "Condition": "HasCode",
      "Properties": {
        "PolicyName": "sync-follow-ups",
        "Roles": [
          {
            "Ref": "ExecutionRole"
          }
        ],
        "PolicyDocument": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Sid": "OwnFollowUps",
              "Effect": "Allow",
              "Action": [
                "scheduler:CreateSchedule",
                "scheduler:GetSchedule",
                "scheduler:DeleteSchedule"
              ],
              "Resource": {
                "Fn::Sub": "arn:aws:scheduler:${AWS::Region}:${AWS::AccountId}:schedule/${FollowUps}/*"
              }
            },
            {
              "Sid": "HandTheSchedulerItsRole",
              "Effect": "Allow",
              "Action": "iam:PassRole",
              "Resource": {
                "Fn::GetAtt": [
                  "SchedulerRole",
                  "Arn"
                ]
              },
              "Condition": {
                "StringEquals": {
                  "iam:PassedToService": "scheduler.amazonaws.com"
                }
              }
            }
          ]
        }
      }
    },
    "Schedule": {
      "Type": "AWS::Scheduler::Schedule",
      "Condition": "HasCode",
      "Properties": {
        "Name": {
          "Fn::Sub": "${AWS::StackName}-probe"
        },
        "Description": "Run the sync probe every half hour",
        "ScheduleExpression": "rate(30 minutes)",
        "FlexibleTimeWindow": {
          "Mode": "OFF"
        },
        "State": "ENABLED",
        "Target": {
          "Arn": {
            "Fn::GetAtt": [
              "Function",
              "Arn"
            ]
          },
          "RoleArn": {
            "Fn::GetAtt": [
              "SchedulerRole",
              "Arn"
            ]
          },
          "RetryPolicy": {
            "MaximumRetryAttempts": 1,
            "MaximumEventAgeInSeconds": 600
          },
          "Input": "{\"clock\": true}"
        }
      }
    },
    "OriginAccess": {
      "Type": "AWS::CloudFront::OriginAccessControl",
      "Properties": {
        "OriginAccessControlConfig": {
          "Name": {
            "Fn::Sub": "${AWS::StackName}-site"
          },
          "Description": "CloudFront signs its reads of the sync site bucket",
          "OriginAccessControlOriginType": "s3",
          "SigningBehavior": "always",
          "SigningProtocol": "sigv4"
        }
      }
    },
    "CachePolicy": {
      "Type": "AWS::CloudFront::CachePolicy",
      "Properties": {
        "CachePolicyConfig": {
          "Name": {
            "Fn::Sub": "${AWS::StackName}-site"
          },
          "Comment": "sync page: short cache, the probe rewrites it every half hour",
          "MinTTL": 0,
          "DefaultTTL": 60,
          "MaxTTL": 300,
          "ParametersInCacheKeyAndForwardedToOrigin": {
            "EnableAcceptEncodingGzip": true,
            "EnableAcceptEncodingBrotli": true,
            "CookiesConfig": {
              "CookieBehavior": "none"
            },
            "HeadersConfig": {
              "HeaderBehavior": "none"
            },
            "QueryStringsConfig": {
              "QueryStringBehavior": "none"
            }
          }
        }
      }
    },
    "IndexFunction": {
      "Type": "AWS::CloudFront::Function",
      "Properties": {
        "Name": {
          "Fn::Sub": "${AWS::StackName}-index"
        },
        "AutoPublish": true,
        "FunctionConfig": {
          "Comment": "Map directory paths to their index.html",
          "Runtime": "cloudfront-js-2.0"
        },
        "FunctionCode": "function handler(event) {\n  var request = event.request;\n  var uri = request.uri;\n  if (uri.endsWith('/')) {\n    request.uri = uri + 'index.html';\n  } else if (!uri.includes('.')) {\n    request.uri = uri + '/index.html';\n  }\n  return request;\n}\n"
      }
    },
    "Distribution": {
      "Type": "AWS::CloudFront::Distribution",
      "Properties": {
        "DistributionConfig": {
          "Enabled": true,
          "Comment": "sync.thingelstad.xyz",
          "HttpVersion": "http2and3",
          "IPV6Enabled": true,
          "PriceClass": "PriceClass_100",
          "DefaultRootObject": "index.html",
          "Aliases": {
            "Fn::If": [
              "HasCertificate",
              [
                "sync.thingelstad.xyz"
              ],
              {
                "Ref": "AWS::NoValue"
              }
            ]
          },
          "ViewerCertificate": {
            "Fn::If": [
              "HasCertificate",
              {
                "AcmCertificateArn": {
                  "Ref": "CertificateArn"
                },
                "SslSupportMethod": "sni-only",
                "MinimumProtocolVersion": "TLSv1.2_2021"
              },
              {
                "CloudFrontDefaultCertificate": true
              }
            ]
          },
          "Origins": [
            {
              "Id": "site",
              "DomainName": {
                "Fn::GetAtt": [
                  "SiteBucket",
                  "RegionalDomainName"
                ]
              },
              "OriginAccessControlId": {
                "Fn::GetAtt": [
                  "OriginAccess",
                  "Id"
                ]
              },
              "S3OriginConfig": {
                "OriginAccessIdentity": ""
              }
            }
          ],
          "DefaultCacheBehavior": {
            "TargetOriginId": "site",
            "ViewerProtocolPolicy": "redirect-to-https",
            "AllowedMethods": [
              "GET",
              "HEAD"
            ],
            "CachedMethods": [
              "GET",
              "HEAD"
            ],
            "Compress": true,
            "CachePolicyId": {
              "Ref": "CachePolicy"
            },
            "ResponseHeadersPolicyId": "67f7725c-6f97-4210-82d7-5512b31e9d03",
            "FunctionAssociations": [
              {
                "EventType": "viewer-request",
                "FunctionARN": {
                  "Fn::GetAtt": [
                    "IndexFunction",
                    "FunctionARN"
                  ]
                }
              }
            ]
          },
          "CustomErrorResponses": [
            {
              "ErrorCode": 403,
              "ResponseCode": 404,
              "ResponsePagePath": "/404.html",
              "ErrorCachingMinTTL": 60
            },
            {
              "ErrorCode": 404,
              "ResponseCode": 404,
              "ResponsePagePath": "/404.html",
              "ErrorCachingMinTTL": 60
            }
          ]
        }
      }
    }
  },
  "Outputs": {
    "CodeBucket": {
      "Value": {
        "Ref": "CodeBucket"
      }
    },
    "SiteBucket": {
      "Value": {
        "Ref": "SiteBucket"
      }
    },
    "FunctionName": {
      "Value": {
        "Fn::If": [
          "HasCode",
          {
            "Ref": "Function"
          },
          ""
        ]
      }
    },
    "DistributionId": {
      "Value": {
        "Ref": "Distribution"
      }
    },
    "DistributionDomain": {
      "Value": {
        "Fn::GetAtt": [
          "Distribution",
          "DomainName"
        ]
      }
    },
    "PublishingBus": {
      "Value": {
        "Ref": "PublishingBus"
      }
    },
    "PublishingBusArn": {
      "Value": {
        "Fn::GetAtt": [
          "PublishingBus",
          "Arn"
        ]
      }
    },
    "FollowUpGroup": {
      "Value": {
        "Ref": "FollowUps"
      }
    }
  }
}
